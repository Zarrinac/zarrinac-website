# Copy to docker/.env (gitignored) and fill in.
# Compose reads this file for BOTH the build args and the runtime environment.

# ---- Public identity (BUILD args — change one and you must rebuild) ---------
NEXT_PUBLIC_SITE_URL=https://znci.ir
# Tags rows in the shared DB. Only 'hisense' | 'zarrinac' are valid (lib/siteId.ts).
NEXT_PUBLIC_SITE_ID=zarrinac
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# Leave EMPTY unless znci.ir gets its own properties. Reusing zarrinac.com's
# GA4 id or GSC/Bing tokens on a second domain corrupts both sites' data.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# ---- Runtime ---------------------------------------------------------------
# /admin bootstrap login. This build has no DATABASE_URL, so the AdminUser table
# is unavailable and these env credentials are the only way in.
# Omit all three to ship the public site with /admin returning 503.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Any long random string, e.g.  openssl rand -hex 32
ADMIN_SESSION_SECRET=change-this-long-random-session-secret

# ---- Host wiring -----------------------------------------------------------
ZNCI_PORT=3010
ZNCI_IMAGE=znci-website:latest
# Host media folder. Relative paths resolve against docker/.
ZNCI_MEDIA_DIR=../../media
