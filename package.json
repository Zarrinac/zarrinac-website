{
  "name": "hisense",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:migrate": "prisma migrate dev --name init",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run db:seed:products && npm run db:seed:locations && npm run db:seed:downloads && npm run db:seed:representatives",
    "db:seed:products": "tsx scripts/seed-products.ts",
    "db:seed:locations": "tsx scripts/seed-iran-locations.ts",
    "db:seed:downloads": "tsx scripts/seed-download-assets.ts",
    "db:seed:representatives": "tsx scripts/seed-service-representatives.ts"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.4.0",
    "@mui/icons-material": "^9.0.1",
    "@mui/material": "^9.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "next": "^16.2.7",
    "next-intl": "^4.13.0",
    "next-seo": "^7.2.0",
    "pg": "^8.21.0",
    "react": "19.2.7",
    "react-date-object": "^2.1.9",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.77.0",
    "react-icons": "^5.6.0",
    "react-multi-date-picker": "^4.5.2",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/css": "^1.3.0",
    "@eslint/eslintrc": "^3",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.2.0",
    "@next/eslint-plugin-next": "^16.2.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "autoprefixer": "^10.5.0",
    "baseline-browser-mapping": "^2.10.34",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "npm-check-updates": "^22.2.3",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6",
    "typescript-eslint": "^8.60.1"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*": "prettier --write --ignore-unknown"
  }
